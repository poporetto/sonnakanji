---
import Base from '../../layouts/Base.astro';
import KanjiTile from '../../components/KanjiTile.astro';
import { byLevel, kanjiPath, LEVELS } from '../../lib/kanji';

export function getStaticPaths() {
  return LEVELS.map((l) => ({ params: { level: l.slug }, props: { level: l } }));
}
const { level } = Astro.props;
const list = byLevel(level.id);
const title = `All ${list.length} JLPT ${level.id} kanji with mnemonics | SonnaKanji`;
const description = `Every JLPT ${level.id} kanji with its meaning, on'yomi and kun'yomi readings, a picture-based mnemonic and spaced repetition review.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `JLPT ${level.id} kanji`,
  numberOfItems: list.length,
  itemListElement: list.map((k, i) => ({
    '@type': 'ListItem', position: i + 1, name: k.kanji, url: new URL(kanjiPath(k.kanji), Astro.site).href,
  })),
};
---
<Base {title} {description} {jsonLd}>
  <h1>JLPT {level.id} kanji</h1>
  <p class="muted">{level.blurb} Open any card for its picture, mnemonic and readings. Kanji you've reviewed get a star.</p>
  <p class="actions">
    <a class="btn primary" href={`/review/?level=${level.id}`}>Review {level.id}</a>
    <a class="btn" href={kanjiPath(list[0].kanji)}>Start from the first card</a>
  </p>
  <ul class="grid">
    {list.map((k, i) => (
      <li><KanjiTile {k} index={i} /></li>
    ))}
  </ul>
</Base>

<style>
  h1 { font-size: clamp(36px, 8vw, 52px); margin: 12px 0 8px; font-weight: 800; letter-spacing: -.03em; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>

<script>
  import { loadStore } from '../../lib/srs';

  // Stars come from this browser's review history, so they appear after load.
  const seen = new Set(Object.keys(loadStore().cards).map((key) => key.split(':')[1]));
  document.querySelectorAll<HTMLElement>('.tile[data-k]').forEach((el) => {
    if (seen.has(el.dataset.k!)) el.classList.add('done');
  });
</script>
