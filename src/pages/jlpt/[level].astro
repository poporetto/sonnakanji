---
import Base from '../../layouts/Base.astro';
import KanjiTile from '../../components/KanjiTile.astro';
import { byLevel, kanjiPath, LEVELS } from '../../lib/kanji';

export function getStaticPaths() {
  return LEVELS.map((l) => ({ params: { level: l.slug }, props: { level: l } }));
}
const { level } = Astro.props;
const list = byLevel(level.id);
const title = level.beta
  ? `All ${list.length.toLocaleString('en')} JLPT ${level.id} kanji (beta) | SonnaKanji`
  : `All ${list.length} JLPT ${level.id} kanji with mnemonics | SonnaKanji`;
const description = level.beta
  ? `Every JLPT ${level.id} kanji with its meaning, on'yomi and kun'yomi readings, stroke order and common words. Now in beta, with free spaced repetition review.`
  : `Every JLPT ${level.id} kanji with its meaning, on'yomi and kun'yomi readings, a picture-based mnemonic and spaced repetition review.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `JLPT ${level.id} kanji`,
  numberOfItems: list.length,
  itemListElement: list.map((k, i) => ({
    '@type': 'ListItem', position: i + 1, name: k.kanji, url: new URL(kanjiPath(k.kanji), Astro.site).href,
  })),
};
---
<Base {title} {description} {jsonLd}>
  <h1>JLPT {level.id} kanji{level.beta && <span class="beta">Beta</span>}</h1>
  {level.beta
    ? <p class="muted">{level.blurb} This level is in beta: readings, stroke order and example words are ready, and drawings and mnemonics are still being made. Levels come from unofficial lists, so expect some rough edges. Kanji you've reviewed get a star.</p>
    : <p class="muted">{level.blurb} Open any card for its picture, mnemonic and readings. Kanji you've reviewed get a star.</p>}
  <p class="actions">
    <a class="btn primary" href={`/review/?level=${level.id}`}>Review {level.id}</a>
    <a class="btn" href={kanjiPath(list[0].kanji)}>Start from the first card</a>
  </p>
  <div class="trail" id="trail">
    <img class="walker" src="/mascot/bear.webp" alt="" width="38" height="30" />
    <div class="trail-track"><i></i></div>
  </div>
  <p class="muted count" id="trail-count" data-total={list.length}>0 of {list.length} kanji reviewed</p>
  <ul class="grid">
    {list.map((k, i) => (
      <li><KanjiTile {k} index={i} eager={i < 12} /></li>
    ))}
  </ul>
</Base>

<style>
  h1 .beta { vertical-align: middle; margin-left: 10px; }
  h1 { font-size: clamp(36px, 8vw, 52px); margin: 12px 0 8px; font-weight: 800; letter-spacing: -.03em; }
  .count { margin: 6px 0 0; font-size: 14px; font-weight: 700; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>

<script>
  import { loadStore } from '../../lib/srs';

  // Stars come from this browser's review history, so they appear after load.
  const seen = new Set(Object.keys(loadStore().cards).map((key) => key.split(':')[1]));
  const tiles = [...document.querySelectorAll<HTMLElement>('.tile[data-k]')];
  const done = tiles.filter((el) => seen.has(el.dataset.k!));
  done.forEach((el) => el.classList.add('done'));

  const count = document.getElementById('trail-count')!;
  const total = Number(count.dataset.total);
  count.textContent = done.length === total ? `All ${total} kanji reviewed` : `${done.length} of ${total} kanji reviewed`;
  document.getElementById('trail')!.style.setProperty('--done', `${(done.length / total) * 100}%`);
</script>
