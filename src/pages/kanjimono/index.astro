---
import Analytics from '@vercel/analytics/astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '@fontsource-variable/outfit';
import '@fontsource-variable/figtree';
import '@fontsource/m-plus-rounded-1c/700.css';
import '@fontsource/m-plus-rounded-1c/900.css';
const site = Astro.site;
const canonical = new URL('/kanjimono/', site).href;
const description = 'Kanjimono is a free pixel adventure in Japan. Choose a starter kanji, battle with real compound words, and catch all 246 kanji by knowing their meanings.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
    <GoogleTag />
    <Analytics />
    <title>Kanjimono: catch every kanji in a pixel adventure</title>
    <link rel="preload" as="image" href="/art/kanjimono-logo.webp">
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#14162e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SonnaKanji" />
    <meta property="og:title" content="Kanjimono: catch every kanji in a pixel adventure" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og/kanjimono.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Kanjimono logo, with kanji creatures, a torii gate and Mount Fuji" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og/kanjimono.png', site).href} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main class="console">
      <div class="stage" id="stage" data-scene="title">
        <canvas id="screen" width="240" height="160" aria-label="Game screen"></canvas>
        <h1><span class="sr">Kanjimono: a pixel kanji adventure</span><img src="/art/kanjimono-logo.webp" width="1200" height="401" alt=""></h1>
        <div class="card foe" id="foe-card"><p><b></b><i></i></p><div class="track"><div class="fill"></div></div><output hidden></output></div>
        <div class="card me" id="me-card"><p><b></b><i></i></p><div class="track"><div class="fill"></div></div><output></output></div>
        <section class="panel" id="panel" aria-live="polite" hidden>
          <p id="text"></p>
          <div id="choices"></div>
          <span class="more" aria-hidden="true"></span>
        </section>
      </div>
      <div class="side">
        <section class="panel hud" id="hud"><div id="status" hidden></div></section>
        <div class="pad" id="pad" aria-hidden="true">
          <div class="stick" id="stick"><div class="well"></div><div class="knob" id="knob"></div></div>
          <button data-key="menu" class="menu">Menu</button>
          <button data-key="b" class="b">B</button>
          <button data-key="a" class="a">A</button>
        </div>
        <footer class="hint">
          <p><kbd>Arrows</kbd> walk <kbd>Space</kbd> talk <kbd>Esc</kbd> back <kbd>X</kbd> menu <kbd>M</kbd> settings</p>
          <div class="links"><button class="back" id="open-settings" type="button">Settings</button><a class="back" href="/">Back to SonnaKanji</a></div>
        </footer>
      </div>
    </main>
    <section class="about" aria-label="About Kanjimono">
      <h2>A free kanji adventure</h2>
      <p>Kanjimono is a pixel adventure for learning Japanese. The signs across Japan have gone blank, and only you can bring them back. Choose a starter kanji, explore towns from Sakura Village to Castle Town, and catch all 246 N5 and N4 kanji by knowing what they mean.</p>
      <p>Every battle uses real compound words, so each win teaches you something you can read. Play free in your browser on a phone or computer, with no sign-up. Children mode adds romaji beside the Japanese.</p>
    </section>
    <dialog id="settings" aria-labelledby="settings-title">
      <h2 id="settings-title">Settings</h2>
      <div class="row plain"><span><b>Haru</b></span><div class="pick" role="group" aria-label="Character"><button type="button" data-look="hero">Boy</button><button type="button" data-look="heroine">Girl</button></div></div>
      <button class="row" type="button" role="switch" data-set="music" aria-checked="true"><span><b>Music</b></span><i></i></button>
      <button class="row" type="button" role="switch" data-set="effects" aria-checked="true"><span><b>Sound effects</b></span><i></i></button>
      <button class="row" type="button" role="switch" data-set="kids" aria-checked="false"><span><b>Children mode</b><small>Shows romaji beside all Japanese words and kanji</small></span><i></i></button>
      <button class="done" id="close-settings" type="button">Done</button>
    </dialog>
    <script>
      import '../../kanjimono/main';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ground: #14162e; --surface: #1f2245; --raised: #2d3160; --line: #3c4178;
    --ink: #f4f1ff; --muted: #b6b6dc; --accent: #ffc857; --on-accent: #231a3d;
    --card: #fdf8ef; --card-ink: #231a3d; --card-muted: #5f5678;
    --good: #2fb67c; --low: #eb9a1e; --danger: #e0404f;
    --display: 'Outfit Variable', 'Outfit', system-ui, sans-serif;
    --body: 'Figtree Variable', 'Figtree', system-ui, sans-serif;
    --jp: 'M PLUS Rounded 1c', 'Hiragino Maru Gothic ProN', sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  ::selection { background: var(--accent); color: var(--on-accent); }
  html { touch-action: manipulation; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  html, body { margin: 0; min-height: 100%; background: var(--ground); color: var(--ink); font: 400 1.0625rem/1.45 var(--body), var(--jp); }
  .console { width: min(100%, 496px); margin: 0 auto; padding: max(8px, env(safe-area-inset-top)) 8px max(12px, env(safe-area-inset-bottom)); display: grid; gap: 12px; }

  .stage { position: relative; container-type: inline-size; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 40px -16px #05061a; }
  canvas { display: block; width: 100%; aspect-ratio: 3 / 2; image-rendering: pixelated; background: var(--ground); }
  .stage h1 { display: none; position: absolute; inset: 1.5cqw 0 auto; margin: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .about { width: min(100%, 496px); margin: 12px auto 32px; padding: 0 12px; color: var(--muted); font-size: .9375rem; }
  .about h2 { margin: 0 0 6px; font: 600 1.0625rem/1.3 var(--display); color: var(--ink); }
  .about p { margin: 0 0 8px; }
  @media (min-width: 760px) and (min-height: 800px) { .about { width: 736px; } }
  .stage h1 img { display: block; width: 92cqw; max-width: none; height: auto; margin: 0 auto; }
  /* The title menu sits on the screen itself, under the logo. */
  /* Chunky buttons cut from the same sticker as the logo: round corners, brown ink, white edge. */
  .stage > #choices { --px: calc(100cqw / 240); --ink: #4e2410; position: absolute; inset: 35cqw 18cqw auto; gap: 3cqw; }
  .stage > #choices button {
    --top: #bfeaff; --mid: #62c3f6; --low: #3a9ee8;
    position: relative; justify-content: center; gap: 1.2cqw; min-height: max(44px, 9.5cqw); padding: 4px 10px; border: calc(var(--px) * 2) solid var(--ink); border-radius: calc(var(--px) * 7); background-origin: border-box;
    background: linear-gradient(var(--top) 0 18%, var(--mid) 18% 72%, var(--low) 72%); color: var(--ink);
    font: 800 clamp(.875rem, 3.5cqw, 1.3rem)/1 var(--display); letter-spacing: -.01em;
    box-shadow: 0 0 0 calc(var(--px) * 1.2) #fff, 0 calc(var(--px) * 4) 0 calc(var(--px) * 1.2) #1e2a5855;
  }
  .stage > #choices button.on, .stage > #choices button:hover { --top: #fff0a0; --mid: #ffcb3d; --low: #f7a01f; background: linear-gradient(var(--top) 0 18%, var(--mid) 18% 72%, var(--low) 72%); color: var(--ink); }
  .stage > #choices button.on::before { content: ''; flex: none; width: calc(var(--px) * 4); height: calc(var(--px) * 6); background: var(--ink); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .stage > #choices button:active { translate: 0 var(--px); }
  [data-scene='title'] h1 { display: block; }

  .card { display: none; position: absolute; width: 44cqw; padding: 1.8cqw 2.4cqw 2cqw; border-radius: 2.8cqw; background: var(--card); color: var(--card-ink); box-shadow: 0 1cqw 3cqw -1cqw #16123a; font-size: max(12px, 3cqw); line-height: 1.2; }
  [data-scene='battle'] .card { display: block; }
  .card.foe { top: 3cqw; left: 3cqw; }
  .card.me { right: 3cqw; bottom: 3cqw; }
  .card p { display: flex; justify-content: space-between; align-items: baseline; gap: 1em; margin: 0 0 1cqw; }
  .card b { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 600 1.1em/1.2 var(--display); }
  .card i { flex: none; font: 500 .9em/1.2 var(--display); font-variant-numeric: tabular-nums; color: var(--card-muted); }
  .track { height: max(5px, 1.3cqw); border-radius: 99px; background: #e4dccd; overflow: hidden; }
  .fill { height: 100%; border-radius: inherit; background: var(--good); transition: width .5s cubic-bezier(.16, 1, .3, 1), background-color .3s; }
  .fill[data-level='low'] { background: var(--low); }
  .fill[data-level='danger'] { background: var(--danger); }
  .card output[hidden] { display: none; }
  .card output:not([hidden]) { display: block; margin-top: .7cqw; text-align: right; font: 500 .9em/1.2 var(--display); font-variant-numeric: tabular-nums; color: var(--card-muted); }

  .pop { position: absolute; z-index: 3; transform: translate(-50%, -50%); font: 800 max(18px, 5.5cqw)/1 var(--display); color: #fff; -webkit-text-stroke: 4px #231a3d; paint-order: stroke fill; pointer-events: none; animation: rise .9s cubic-bezier(.16, 1, .3, 1) both; }
  .pop.big { font-size: max(24px, 7.5cqw); color: var(--accent); }
  .pop.good { color: var(--accent); }
  .callout { position: absolute; z-index: 2; left: 50%; top: 42%; display: grid; justify-items: center; gap: .3cqw; padding: 1.2cqw 3.4cqw 1.6cqw; border-radius: 2.8cqw; background: #231a3dd9; color: #fff; pointer-events: none; animation: slam 1.15s cubic-bezier(.16, 1, .3, 1) both; }
  .callout b { font: 700 max(22px, 7cqw)/1.15 var(--jp); }
  .callout span { font: 500 max(12px, 2.9cqw)/1.2 var(--display); white-space: nowrap; }
  .card.danger .fill { animation: pulse .7s ease-in-out infinite alternate; }
  @keyframes rise { from { opacity: 0; translate: 0 8px; scale: .7; } 25% { opacity: 1; scale: 1.15; } 70% { opacity: 1; } to { opacity: 0; translate: 0 -28px; scale: 1; } }
  @keyframes slam { from { opacity: 0; transform: translate(-50%, -50%) scale(1.5); } 16% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 82% { opacity: 1; transform: translate(-50%, -50%) scale(1); } to { opacity: 0; transform: translate(-50%, -50%) scale(.96); } }
  @keyframes pulse { to { opacity: .45; } }

  .panel { display: flex; flex-direction: column; }
  .panel[hidden] { display: none; }
  .console:has([data-scene='title']) .hud { visibility: hidden; }
  @media not (pointer: coarse) { .console:has([data-scene='title']) .hud { display: none; } }
  .more { display: none; flex: none; align-self: flex-end; width: 16px; height: 12px; margin-top: auto; background: var(--accent); clip-path: polygon(0 0, 100% 0, 50% 100%); animation: nudge .8s ease-in-out infinite alternate; }
  .panel.waiting { cursor: pointer; }
  .panel.waiting .more { display: block; }
  .panel.typing .more { display: none; }
  @keyframes nudge { to { translate: 0 4px; } }

  .side { display: grid; gap: 12px; align-content: start; min-width: 0; }
  .panel { height: 216px; overflow-y: auto; overscroll-behavior: contain; padding: 16px; border-radius: 18px; background: var(--surface); }
  /* Outside battle, dialogue sits on the game screen. */
  .stage > .panel { position: absolute; inset: auto 2.5cqw 2.5cqw; height: 108px; padding: 10px 28px 10px 14px; overflow: hidden; border: 2px solid var(--line); border-radius: 14px; box-shadow: 0 6px 16px -8px #05061a; }
  .stage > .panel .more { position: absolute; right: 10px; bottom: 10px; }
  .stage > .panel #text { margin: 0; }
  .stage > .panel #text span { font-size: .9375rem; line-height: 1.35; }
  /* Menus and shop lists may take the whole screen. */
  .stage > .panel:has(#choices button) { height: auto; max-height: calc(100% - 5cqw); overflow-y: auto; }
  .stage > .panel:has(#choices button) #text { margin-bottom: 8px; }
  .stage > .panel #choices { gap: 6px; }
  .stage > .panel #choices button { min-height: 38px; padding-block: 4px; }
  @media (pointer: coarse) { .stage > .panel #choices button { min-height: 44px; } }
  .unread { opacity: 0; }
  #text { display: grid; gap: 2px; margin: 0 0 12px; max-width: 62ch; white-space: pre-line; }
  #status { display: grid; gap: 12px; }
  #status[hidden], #text[hidden] { display: none; }
  #status header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  #status h2 { margin: 0; font: 600 1.25rem/1.2 var(--display); letter-spacing: -.01em; }
  .tag { padding: 2px 9px; border-radius: 99px; background: var(--accent); color: var(--on-accent); font: 600 .8125rem/1.4 var(--display); }
  .mission { display: grid; gap: 4px; padding: 12px; border-radius: 12px; background: var(--raised); }
  .mission h3 { margin: 0; font: 600 1rem/1.3 var(--display); color: var(--accent); }
  .mission p { margin: 0; font-size: 1rem; line-height: 1.4; }
  .progress { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin-top: 6px; font: 500 .875rem/1 var(--display); font-variant-numeric: tabular-nums; color: var(--muted); }
  .bar { height: 6px; border-radius: 99px; background: var(--ground); overflow: hidden; }
  .bar div { height: 100%; border-radius: inherit; background: var(--accent); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .stats li { display: grid; gap: 1px; padding: 8px 10px; border-radius: 10px; background: var(--raised); }
  .stats b { font: 600 1rem/1.2 var(--display); font-variant-numeric: tabular-nums; }
  .stats span { font-size: .8125rem; line-height: 1.2; color: var(--muted); }
  #text.bear { min-height: 64px; padding-left: 72px; background: url('/mascot/bear.webp') left top / 60px auto no-repeat; }
  #text:empty { display: none; }
  #text:last-child { margin: 0; }
  #text strong { font: 600 .9375rem/1.3 var(--display); color: var(--accent); }
  #text small { font-size: .9375rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  #choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 8px; }
  #choices:empty { display: none; }
  #choices button { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 6px 14px; text-wrap: balance; overflow-wrap: anywhere; border: 0; border-radius: 12px; background: var(--raised); color: var(--ink); font: 500 1rem/1.2 var(--display); text-align: left; cursor: pointer; transition: background-color .15s, color .15s; }
  #choices button.long { font-size: .875rem; }
  #choices button.ware { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 8px; padding: 6px 10px; }
  .ware .icon { width: 30px; height: auto; aspect-ratio: auto; background: none; image-rendering: pixelated; }
  .ware .words { display: grid; gap: 1px; min-width: 0; }
  .ware .words b { font: 700 .9375rem/1.15 var(--jp); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ware .words small { font: 500 .8125rem/1.15 var(--body); opacity: .8; }
  .ware .price { font: 600 1rem/1 var(--display); font-variant-numeric: tabular-nums; }
  @media (max-width: 519px) { #choices:has(.ware) { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; gap: 6px; } }
  #choices .ja { font: 700 1.3rem/1 var(--jp); }
  #choices button:hover { background: var(--line); }
  #choices button.on { background: var(--accent); color: var(--on-accent); }
  #choices button.full { grid-column: 1 / -1; }
  a:focus-visible, #choices button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .pad { display: none; grid-template-columns: 136px 1fr 60px 76px; align-items: center; gap: 12px 10px; touch-action: none; user-select: none; -webkit-user-select: none; }
  .pad button { display: grid; place-items: center; border: 0; background: var(--raised); color: var(--ink); font: 600 1rem/1 var(--display); }
  .pad button:active { background: var(--accent); color: var(--on-accent); }
  .stick { position: relative; width: 136px; height: 136px; border-radius: 50%; background: var(--raised); touch-action: none; }
  .stick .well { position: absolute; inset: 10px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--line); }
  .knob { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: var(--line); box-shadow: inset 0 3px 0 #ffffff24, 0 4px 10px -2px #05061a; pointer-events: none; }
  .stick.on .knob { background: var(--accent); }
  .stick { grid-row: 1 / 3; }
  .menu { grid-column: 2 / -1; justify-self: end; height: 44px; padding: 0 18px; border-radius: 99px; }
  .pad .b { grid-column: 3; align-self: end; width: 60px; height: 60px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--line); font-size: 1.125rem; font-weight: 700; }
  .pad .a { grid-column: 4; width: 76px; height: 76px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 1.375rem; font-weight: 700; }

  .hint { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; padding: 0 4px; color: var(--muted); font-size: .9375rem; }
  .hint p { margin: 0; }
  .hint kbd { margin-left: 8px; padding: 1px 7px; border-radius: 6px; background: var(--raised); color: var(--ink); font: 500 .875rem/1.4 var(--display); }
  .hint kbd:first-child { margin-left: 0; }
  .roma { margin-left: .3em; font: 500 .72em/1 var(--body); opacity: .8; }
  dialog { width: min(100% - 32px, 400px); padding: 20px; border: 0; border-radius: 18px; background: var(--surface); color: var(--ink); box-shadow: 0 18px 40px -16px #05061a; }
  dialog::backdrop { background: #0a0b1cb3; }
  dialog h2 { margin: 0 0 12px; font: 600 1.25rem/1.2 var(--display); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-height: 56px; margin-bottom: 8px; padding: 8px 14px; border: 0; border-radius: 12px; background: var(--raised); color: var(--ink); text-align: left; cursor: pointer; }
  .row.plain { cursor: default; }
  .pick { display: flex; gap: 4px; padding: 3px; border-radius: 99px; background: var(--ground); }
  .pick button { min-height: 32px; padding: 0 14px; border: 0; border-radius: 99px; background: none; color: var(--muted); font: 600 .875rem/1 var(--display); cursor: pointer; }
  .pick button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); }
  .row span { display: grid; gap: 2px; min-width: 0; }
  .row b { font: 600 1rem/1.25 var(--display); }
  .row small { font: 400 .875rem/1.3 var(--body); color: var(--muted); }
  .row i { flex: none; position: relative; width: 46px; height: 26px; border-radius: 99px; background: var(--ground); transition: background-color .15s; }
  .row i::after { content: ''; position: absolute; left: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--muted); transition: transform .15s, background-color .15s; }
  .row[aria-checked='true'] i { background: var(--accent); }
  .row[aria-checked='true'] i::after { transform: translateX(20px); background: var(--on-accent); }
  .done { width: 100%; min-height: 48px; margin-top: 4px; border: 0; border-radius: 12px; background: var(--accent); color: var(--on-accent); font: 600 1rem/1 var(--display); cursor: pointer; }
  dialog button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .field { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; font: 500 .9375rem/1.3 var(--display); }
  .field select, .field input { min-width: 0; min-height: 36px; padding: 0 8px; border: 0; border-radius: 8px; background: var(--raised); color: var(--ink); font: 500 .9375rem/1 var(--body); }
  .field select { flex: 1; max-width: 240px; }
  .field input { width: 72px; font-variant-numeric: tabular-nums; }
  .tools { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 10px 0; }
  .tool { min-height: 38px; padding: 4px 8px; border: 0; border-radius: 8px; background: var(--raised); color: var(--ink); font: 500 .875rem/1.15 var(--display); cursor: pointer; }
  .links { display: flex; gap: 6px; }
  .back { padding: 1px 9px; border: 0; cursor: pointer; border-radius: 6px; background: var(--raised); color: var(--ink); font: 500 .875rem/1.4 var(--display); text-decoration: none; transition: background-color .15s; }
  .back:hover { background: var(--line); }

  @media (pointer: coarse) { .pad { display: grid; } .hint p { display: none; } }
  /* On phones the page fills the screen exactly: the panel takes the spare room, so the controls never move. */
  @media (pointer: coarse) and (min-height: 600px) {
    html, body { height: 100%; overflow: hidden; }
    .console { height: 100dvh; grid-template-rows: auto minmax(0, 1fr); }
    .side { grid-template-rows: minmax(0, 1fr) auto auto; min-height: 0; }
    .panel { height: auto; min-height: 0; }
  }
  @media (max-width: 360px) { .pad { grid-template-columns: 136px 1fr 52px 64px; } .pad .a { width: 64px; height: 64px; } .pad .b { width: 52px; height: 52px; } }
  /* The panel always sits under the screen. Exact 2x and 3x sizes keep the pixels even. */
  @media (min-width: 760px) {
    #status { grid-template-columns: minmax(0, 1fr) 190px; align-items: stretch; }
