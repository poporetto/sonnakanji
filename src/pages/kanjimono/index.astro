---
import GoogleTag from '../../components/GoogleTag.astro';
import '@fontsource-variable/outfit';
import '@fontsource-variable/figtree';
import '@fontsource/m-plus-rounded-1c/700.css';
const site = Astro.site;
const canonical = new URL('/kanjimono/', site).href;
const description = 'Kanjimono is a free pixel adventure in Japan. Choose a starter kanji, battle with real compound words, and catch all 245 kanji by knowing their meanings.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
    <GoogleTag />
    <title>Kanjimono: catch every kanji in a pixel adventure</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#14162e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="console">
      <div class="stage" id="stage" data-scene="title">
        <canvas id="screen" width="240" height="160" aria-label="Game screen"></canvas>
        <h1>Kanjimono<span lang="ja">漢字もの</span></h1>
        <div class="card foe" id="foe-card"><p><b></b><i></i></p><div class="track"><div class="fill"></div></div><output hidden></output></div>
        <div class="card me" id="me-card"><p><b></b><i></i></p><div class="track"><div class="fill"></div></div><output></output></div>
      </div>
      <div class="side">
        <section class="panel" id="panel" aria-live="polite">
          <div id="status" hidden></div>
          <p id="text"></p>
          <div id="choices"></div>
        </section>
        <div class="pad" id="pad" aria-hidden="true">
          <div class="dpad">
            <button data-key="up" class="up">{/*u*/}<svg viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(0deg)"><path d="m6 15 6-6 6 6"/></svg></button>
            <button data-key="left" class="left"><svg viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(-90deg)"><path d="m6 15 6-6 6 6"/></svg></button>
            <button data-key="right" class="right"><svg viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(90deg)"><path d="m6 15 6-6 6 6"/></svg></button>
            <button data-key="down" class="down"><svg viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(180deg)"><path d="m6 15 6-6 6 6"/></svg></button>
          </div>
          <button data-key="menu" class="menu">Menu</button>
          <button data-key="a" class="a">A</button>
        </div>
        <footer class="hint">
          <p><kbd>Arrows</kbd> walk <kbd>Z</kbd> talk <kbd>X</kbd> menu <kbd>M</kbd> sound</p>
          <div class="links"><button class="back" id="sound" type="button">Sound on</button><a class="back" href="/">Back to SonnaKanji</a></div>
        </footer>
      </div>
    </main>
    <script>
      import '../../kanjimono/main';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ground: #14162e; --surface: #1f2245; --raised: #2d3160; --line: #3c4178;
    --ink: #f4f1ff; --muted: #b6b6dc; --accent: #ffc857; --on-accent: #231a3d;
    --card: #fdf8ef; --card-ink: #231a3d; --card-muted: #5f5678;
    --good: #2fb67c; --low: #eb9a1e; --danger: #e0404f;
    --display: 'Outfit Variable', 'Outfit', system-ui, sans-serif;
    --body: 'Figtree Variable', 'Figtree', system-ui, sans-serif;
    --jp: 'M PLUS Rounded 1c', 'Hiragino Maru Gothic ProN', sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  ::selection { background: var(--accent); color: var(--on-accent); }
  html, body { margin: 0; min-height: 100%; background: var(--ground); color: var(--ink); font: 400 1.0625rem/1.45 var(--body), var(--jp); }
  .console { width: min(100%, 496px); margin: 0 auto; padding: max(8px, env(safe-area-inset-top)) 8px max(12px, env(safe-area-inset-bottom)); display: grid; gap: 12px; }

  .stage { position: relative; container-type: inline-size; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 40px -16px #05061a; }
  canvas { display: block; width: 100%; aspect-ratio: 3 / 2; image-rendering: pixelated; background: var(--ground); }
  .stage h1 { display: none; position: absolute; inset: 7.6cqw 0 auto; margin: 0; text-align: center; font: 800 11.5cqw/1 var(--display); letter-spacing: -.03em; color: #3a2a4e; }
  .stage h1 span { display: block; margin-top: 1.1cqw; font: 700 3.2cqw/1 var(--jp); letter-spacing: .32em; text-indent: .32em; color: #d6332a; }
  [data-scene='title'] h1 { display: block; }

  .card { display: none; position: absolute; width: 44cqw; padding: 1.8cqw 2.4cqw 2cqw; border-radius: 2.8cqw; background: var(--card); color: var(--card-ink); box-shadow: 0 1cqw 3cqw -1cqw #16123a; font-size: max(12px, 3cqw); line-height: 1.2; }
  [data-scene='battle'] .card { display: block; }
  .card.foe { top: 3cqw; left: 3cqw; }
  .card.me { right: 3cqw; bottom: 3cqw; }
  .card p { display: flex; justify-content: space-between; align-items: baseline; gap: 1em; margin: 0 0 1cqw; }
  .card b { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 600 1.1em/1.2 var(--display); }
  .card i { flex: none; font: 500 .9em/1.2 var(--display); font-variant-numeric: tabular-nums; color: var(--card-muted); }
  .track { height: max(5px, 1.3cqw); border-radius: 99px; background: #e4dccd; overflow: hidden; }
  .fill { height: 100%; border-radius: inherit; background: var(--good); transition: width .5s cubic-bezier(.16, 1, .3, 1), background-color .3s; }
  .fill[data-level='low'] { background: var(--low); }
  .fill[data-level='danger'] { background: var(--danger); }
  .card output[hidden] { display: none; }
  .card output:not([hidden]) { display: block; margin-top: .7cqw; text-align: right; font: 500 .9em/1.2 var(--display); font-variant-numeric: tabular-nums; color: var(--card-muted); }

  .pop { position: absolute; z-index: 3; transform: translate(-50%, -50%); font: 800 max(18px, 5.5cqw)/1 var(--display); color: #fff; -webkit-text-stroke: 4px #231a3d; paint-order: stroke fill; pointer-events: none; animation: rise .9s cubic-bezier(.16, 1, .3, 1) both; }
  .pop.big { font-size: max(24px, 7.5cqw); color: var(--accent); }
  .pop.good { color: var(--accent); }
  .callout { position: absolute; z-index: 2; left: 50%; top: 42%; display: grid; justify-items: center; gap: .3cqw; padding: 1.2cqw 3.4cqw 1.6cqw; border-radius: 2.8cqw; background: #231a3dd9; color: #fff; pointer-events: none; animation: slam 1.15s cubic-bezier(.16, 1, .3, 1) both; }
  .callout b { font: 700 max(22px, 7cqw)/1.15 var(--jp); }
  .callout span { font: 500 max(12px, 2.9cqw)/1.2 var(--display); white-space: nowrap; }
  .stamp { position: absolute; z-index: 3; right: 6cqw; top: 6cqw; display: grid; place-items: center; min-width: 19cqw; height: 19cqw; padding-inline: 2cqw; border: .9cqw solid #c7302c; border-radius: 3cqw; background: #fdf8ef; color: #c7302c; font: 700 11cqw/1 var(--jp); pointer-events: none; animation: seal 1.25s cubic-bezier(.16, 1, .3, 1) both; }
  .card.danger .fill { animation: pulse .7s ease-in-out infinite alternate; }
  @keyframes rise { from { opacity: 0; translate: 0 8px; scale: .7; } 25% { opacity: 1; scale: 1.15; } 70% { opacity: 1; } to { opacity: 0; translate: 0 -28px; scale: 1; } }
  @keyframes slam { from { opacity: 0; transform: translate(-50%, -50%) scale(1.5); } 16% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 82% { opacity: 1; transform: translate(-50%, -50%) scale(1); } to { opacity: 0; transform: translate(-50%, -50%) scale(.96); } }
  @keyframes seal { from { opacity: 0; transform: scale(2.2) rotate(-14deg); } 18% { opacity: 1; transform: scale(1) rotate(-6deg); } 80% { opacity: 1; transform: scale(1) rotate(-6deg); } to { opacity: 0; transform: scale(1) rotate(-6deg); } }
  @keyframes pulse { to { opacity: .45; } }

  .side { display: grid; gap: 12px; align-content: start; min-width: 0; }
  .panel { min-height: 212px; padding: 16px; border-radius: 18px; background: var(--surface); }
  #text { display: grid; gap: 2px; margin: 0 0 12px; max-width: 62ch; white-space: pre-line; }
  #status { display: grid; gap: 12px; }
  #status[hidden], #text[hidden] { display: none; }
  #status header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  #status h2 { margin: 0; font: 600 1.25rem/1.2 var(--display); letter-spacing: -.01em; }
  .tag { padding: 2px 9px; border-radius: 99px; background: var(--accent); color: var(--on-accent); font: 600 .8125rem/1.4 var(--display); }
  .mission { display: grid; gap: 4px; padding: 12px; border-radius: 12px; background: var(--raised); }
  .mission h3 { margin: 0; font: 600 1rem/1.3 var(--display); color: var(--accent); }
  .mission p { margin: 0; font-size: 1rem; line-height: 1.4; }
  .progress { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin-top: 6px; font: 500 .875rem/1 var(--display); font-variant-numeric: tabular-nums; color: var(--muted); }
  .bar { height: 6px; border-radius: 99px; background: var(--ground); overflow: hidden; }
  .bar div { height: 100%; border-radius: inherit; background: var(--accent); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .stats li { display: grid; gap: 1px; padding: 8px 10px; border-radius: 10px; background: var(--raised); }
  .stats b { font: 600 1rem/1.2 var(--display); font-variant-numeric: tabular-nums; }
  .stats span { font-size: .8125rem; line-height: 1.2; color: var(--muted); }
  #text.bear { min-height: 64px; padding-left: 72px; background: url('/mascot/bear.webp') left top / 60px auto no-repeat; }
  #text:empty { display: none; }
  #text:last-child { margin: 0; }
  #text strong { font: 600 .9375rem/1.3 var(--display); color: var(--accent); }
  #text small { font-size: .9375rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  #choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 8px; }
  #choices:empty { display: none; }
  #choices button { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 6px 14px; text-wrap: balance; overflow-wrap: anywhere; border: 0; border-radius: 12px; background: var(--raised); color: var(--ink); font: 500 1rem/1.2 var(--display); text-align: left; cursor: pointer; transition: background-color .15s, color .15s; }
  #choices button.long { font-size: .875rem; }
  #choices .ja { font: 700 1.3rem/1 var(--jp); }
  #choices button:hover { background: var(--line); }
  #choices button.on { background: var(--accent); color: var(--on-accent); }
  #choices button.full { grid-column: 1 / -1; }
  a:focus-visible, #choices button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .pad { display: none; grid-template-columns: 156px 1fr 76px; align-items: center; gap: 12px; touch-action: none; user-select: none; -webkit-user-select: none; }
  .pad button { display: grid; place-items: center; border: 0; background: var(--raised); color: var(--ink); font: 600 1rem/1 var(--display); }
  .pad button:active { background: var(--accent); color: var(--on-accent); }
  .pad svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .dpad { display: grid; grid-template-columns: repeat(3, 52px); grid-template-rows: repeat(3, 52px); }
  .dpad::after { content: ''; grid-area: 2 / 2; background: var(--raised); }
  .up { grid-area: 1 / 2; border-radius: 14px 14px 0 0; } .left { grid-area: 2 / 1; border-radius: 14px 0 0 14px; }
  .right { grid-area: 2 / 3; border-radius: 0 14px 14px 0; } .down { grid-area: 3 / 2; border-radius: 0 0 14px 14px; }
  .menu { justify-self: end; height: 44px; padding: 0 18px; border-radius: 99px; }
  .pad .a { width: 76px; height: 76px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 1.375rem; font-weight: 700; }

  .hint { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; padding: 0 4px; color: var(--muted); font-size: .9375rem; }
  .hint p { margin: 0; }
  .hint kbd { margin-left: 8px; padding: 1px 7px; border-radius: 6px; background: var(--raised); color: var(--ink); font: 500 .875rem/1.4 var(--display); }
  .hint kbd:first-child { margin-left: 0; }
  .links { display: flex; gap: 6px; }
  .back { padding: 1px 9px; border: 0; cursor: pointer; border-radius: 6px; background: var(--raised); color: var(--ink); font: 500 .875rem/1.4 var(--display); text-decoration: none; transition: background-color .15s; }
  .back:hover { background: var(--line); }

  @media (pointer: coarse) { .pad { display: grid; } .hint p { display: none; } }
  @media (max-width: 360px) { .pad { grid-template-columns: 156px 1fr 64px; } .pad .a { width: 64px; height: 64px; } }
  /* The panel always sits under the screen. Exact 2x and 3x sizes keep the pixels even. */
  @media (min-width: 760px) {
    .panel { min-height: 172px; }
    #status { grid-template-columns: minmax(0, 1fr) 190px; align-items: stretch; }
    #status header { grid-column: 1 / -1; }
    .stats { grid-template-columns: 1fr; gap: 6px; }
    .stats li { grid-template-columns: 1fr auto; align-items: baseline; gap: 8px; padding: 6px 10px; }
    .stats li b { order: 2; }
  }
  @media (min-width: 760px) and (min-height: 800px) {
    .console { width: 736px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fill, #choices button { transition: none; }
    .pop, .callout, .stamp { animation-name: fade; }
    .card.danger .fill { animation: none; }
    @keyframes fade { from, to { opacity: 0; } 15%, 80% { opacity: 1; } }
  }
</style>
