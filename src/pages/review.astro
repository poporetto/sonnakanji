---
import Base from '../layouts/Base.astro';
---
<Base
  title="Free kanji SRS review for JLPT N5 and N4 | SonnaKanji"
  description="Review JLPT N5 and N4 kanji with spaced repetition, like Anki. Free, no sign-up, and your progress stays in your browser."
>
  <div class="review">
    <section id="setup">
      <h1>Review</h1>
      <p class="muted">Spaced repetition shows each kanji just before you'd forget it. No account needed: progress stays in this browser.</p>
      <noscript><p>Reviewing needs JavaScript. The kanji cards work without it.</p></noscript>
      <div class="stats" aria-live="polite">
        <div><b id="s-due">–</b><span>Due</span></div>
        <div><b id="s-new">–</b><span>New today</span></div>
        <div><b id="s-learned">–</b><span>Learned</span></div>
        <div class="streak"><b id="s-streak">–</b><span>Day streak</span></div>
      </div>
      <form id="settings" class="settings">
        <label>Level
          <span class="select"><select name="level"><option value="all">N5 + N4</option><option value="N5">N5</option><option value="N4">N4</option></select></span>
        </label>
        <label>Test me on
          <span class="select"><select name="mode">
            <option value="meaning">Kanji → meaning</option>
            <option value="reading">Kanji → reading</option>
            <option value="recall">Meaning → kanji</option>
          </select></span>
        </label>
        <label>New cards per day
          <span class="select"><select name="newPerDay"><option>5</option><option>10</option><option>20</option><option>50</option></select></span>
        </label>
      </form>
      <button class="btn primary start" id="start" disabled>Loading…</button>
      <details class="backup">
        <summary>Back up or move progress</summary>
        <p class="muted">Progress lives only in this browser. Clearing site data erases it, so keep a backup.</p>
        <button class="btn" id="export">Download backup</button>
        <label class="btn">Restore backup<input id="import" type="file" accept="application/json" hidden /></label>
        <button class="btn" id="reset">Reset all progress</button>
        <p id="backup-msg" class="muted" role="status"></p>
      </details>
    </section>

    <section id="session" hidden>
      <div class="progress"><span id="remaining"></span><button class="link" id="quit">End session</button></div>
      <div class="bar" aria-hidden="true"><i id="bar-fill"></i></div>
      <div class="flash" id="flash" tabindex="0" role="button" aria-label="Show answer">
        <span class="swipe-tag again" id="tag-again">Again</span>
        <span class="swipe-tag good" id="tag-good">Good</span>
        <div id="front"></div>
        <div id="back" aria-live="polite" hidden></div>
      </div>
      <p class="hint muted" id="hint"></p>
      <div class="grades" id="grades" hidden></div>
    </section>

    <section id="done" hidden>
      <div id="confetti" aria-hidden="true"></div>
      <img src="/mascot/bear.webp" alt="" width="170" height="134" />
      <h2>Nice work!</h2>
      <p id="done-msg"></p>
      <button class="btn primary" id="again">Back to review</button>
    </section>
  </div>
</Base>

<style is:global>
  .review { max-width: 520px; margin: 0 auto; }
  .review h1 { font-size: clamp(38px, 9vw, 52px); font-weight: 800; margin: 12px 0 8px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 16px 0; }
  .stats div { background: var(--surface); border-radius: 16px; padding: 8px 2px; text-align: center; box-shadow: var(--soft); min-width: 0; }
  .stats b { display: block; font: 800 26px/1.2 var(--body); font-variant-numeric: tabular-nums; }
  .stats span { display: block; font-size: 12px; font-weight: 700; color: var(--muted); line-height: 1.15; }
  .stats .streak { background: var(--t1); color: var(--on-tint); }
  .stats .streak span { color: var(--on-tint); }
  .settings { display: grid; gap: 10px; margin-bottom: 16px; }
  .settings label { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-weight: 800; font-size: 15px; }
  .select { position: relative; display: block; min-width: 0; }
  .select::after {
    content: ""; position: absolute; top: 50%; right: 14px; width: 12px; height: 12px; margin-top: -6px; background: var(--muted); pointer-events: none; transform: rotate(90deg);
    -webkit-mask: var(--chevron) center / contain no-repeat; mask: var(--chevron) center / contain no-repeat;
  }
  .settings select { appearance: none; -webkit-appearance: none; min-height: 44px; max-width: 100%; font: 700 16px var(--body); padding: 8px 34px 8px 14px; border-radius: 14px; border: 0; background: var(--surface); color: var(--ink); box-shadow: var(--soft); cursor: pointer; }
  .start { width: 100%; padding: 14px; font-size: 18px; }
  .start:disabled { background: var(--wash); color: var(--muted); cursor: default; box-shadow: none; transform: none; }
  .backup { margin-top: 22px; font-size: 15px; font-weight: 600; }
  .backup summary { font-weight: 800; }
  .backup .btn { font-size: 14px; padding: 10px 14px; margin: 0 6px 8px 0; }
  #reset.armed { background: var(--t0); color: var(--on-tint); }
  .progress { display: flex; justify-content: space-between; color: var(--muted); font-size: 14px; font-weight: 700; margin-bottom: 6px; }
  .bar { height: 10px; border-radius: 999px; background: var(--wash); overflow: hidden; margin-bottom: 14px; }
  .bar i { display: block; height: 100%; width: 0; background: var(--t2); transition: width .25s; }
  .link { background: none; border: 0; color: inherit; text-decoration: underline; text-underline-offset: 3px; font: inherit; cursor: pointer; padding: 10px 0; margin-block: -10px; }
  .flash {
    position: relative; background: var(--surface); border-radius: var(--radius); box-shadow: var(--soft);
    padding: 20px 16px; min-height: 360px; display: flex; flex-direction: column; justify-content: center;
    text-align: center; touch-action: pan-y; cursor: pointer; user-select: none; -webkit-user-select: none; overflow-wrap: anywhere;
  }
  .flash .big { font: 700 112px/1.15 var(--jp); }
  .flash .prompt { font: 800 28px/1.15 var(--body); }
  .flash .ask { color: var(--muted); font-size: 15px; font-weight: 700; margin-top: 8px; }
  .flash .pic { display: grid; grid-template-columns: 130px auto; gap: 14px; justify-content: center; align-items: center; }
  .flash .pic img { width: 130px; height: 130px; background: var(--t1); border-radius: 18px; }
  .flash .pic .big { font-size: 96px; }
  .flash .answer { font: 800 23px/1.2 var(--body); margin: 8px 0 4px; }
  .flash .rd { font-size: 17px; margin: 2px 0; }
  .flash .rd small { color: var(--muted); font-weight: 800; }
  .flash .note { font-size: 16px; font-weight: 700; line-height: 1.4; margin: 12px 0 8px; padding: 9px 12px; text-align: left; background: var(--wash); border-radius: 12px; }
  .flash a { display: inline-block; padding-block: 11px 3px; font-size: 13px; font-weight: 700; color: var(--muted); }
  .flash.revealed { cursor: default; }
  .swipe-tag { position: absolute; top: 12px; z-index: 2; font: 800 14px var(--body); padding: 3px 10px; border-radius: 10px; opacity: 0; color: var(--on-tint); }
  .swipe-tag.again { right: 12px; background: var(--t0); }
  .swipe-tag.good { left: 12px; background: var(--t2); }
  .hint { text-align: center; font-size: 13px; font-weight: 700; min-height: 20px; margin: 14px 0 10px; }
  .grades { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .grades button { min-height: 56px; padding: 8px 2px; display: grid; gap: 1px; justify-items: center; touch-action: manipulation; color: var(--on-tint); min-width: 0; }
  .grades button:nth-child(1) { background: var(--t0); }
  .grades button:nth-child(2) { background: var(--t1); }
  .grades button:nth-child(3) { background: var(--t2); }
  .grades button:nth-child(4) { background: var(--t3); }
  .grades small { font-weight: 700; font-size: 12px; }
  #done { position: relative; text-align: center; padding-block: 32px; }
  #done h2 { font-size: 46px; font-weight: 800; margin: 0 0 8px; }
  #done p { font-size: 17px; font-weight: 600; }
  #confetti { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 30; }
  #confetti i { position: absolute; top: -20px; width: 12px; height: 18px; border-radius: 3px; animation: fall 1.6s ease-in forwards; }
  @keyframes fall { to { transform: translateY(110vh) rotate(540deg); } }
</style>

<script>
  import {
    buildQueue, currentStreak, formatInterval, GRADES, grade, loadStore, parseStore, preview, saveStore, summarize, emptyStore,
    introducedToday, type Mode, type Store,
  } from '../lib/srs';
  import { attachSwipe } from '../lib/swipe';
  import { Rating, type Grade } from 'ts-fsrs';

  interface C { k: string; l: string; m: string[]; on: string[]; kun: string[]; n: string; a: string; u: string }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('settings');
  const flash = $('flash');
  const start = $<HTMLButtonElement>('start');

  let store: Store = loadStore();
  let cards: C[] = [];
  let byKanji = new Map<string, C>();
  let queue: string[] = [];
  let reviewed = 0;
  let sessionSize = 0;
  let mode: Mode = 'meaning';
  let revealed = false;

  const show = (name: 'setup' | 'session' | 'done') => {
    for (const s of ['setup', 'session', 'done']) $(s).hidden = s !== name;
  };
  const inLevel = () => cards.filter((c) => store.settings.level === 'all' || c.l === store.settings.level).map((c) => c.k);

  function refresh() {
    const now = new Date();
    const list = inLevel();
    const s = store.settings;
    const { due, fresh, learned } = summarize(store, list, s.mode, now);
    const room = Math.max(s.newPerDay - introducedToday(store, s.mode, now), 0);
    const newToday = Math.min(fresh, room);
    $('s-due').textContent = String(due);
    $('s-new').textContent = String(newToday);
    $('s-learned').textContent = String(learned);
    $('s-streak').textContent = String(currentStreak(store, now));
    start.disabled = due + newToday === 0;
    start.textContent = due + newToday ? `Start ${due + newToday} cards` : 'All caught up for today';
  }

  function readForm() {
    const d = new FormData(form);
    store.settings = {
      level: d.get('level') as Store['settings']['level'],
      mode: d.get('mode') as Mode,
      newPerDay: Number(d.get('newPerDay')),
    };
    saveStore(store);
    refresh();
  }

  function writeForm() {
    const s = store.settings;
    (form.elements.namedItem('level') as HTMLSelectElement).value = s.level;
    (form.elements.namedItem('mode') as HTMLSelectElement).value = s.mode;
    (form.elements.namedItem('newPerDay') as HTMLSelectElement).value = String(s.newPerDay);
  }

  function el(tag: string, cls: string, text?: string, lang?: string) {
    const n = document.createElement(tag);
    n.className = cls;
    if (text !== undefined) n.textContent = text;
    if (lang) n.lang = lang;
    return n;
  }

  function renderCard() {
    const c = byKanji.get(queue[0])!;
    revealed = false;
    const front = $('front');
    const back = $('back');
    front.replaceChildren();
    back.replaceChildren();
    back.hidden = true;
    front.hidden = false;
    $('grades').hidden = true;
    $('remaining').textContent = `${queue.length} left`;
    $('bar-fill').style.width = `${(1 - queue.length / Math.max(sessionSize, queue.length)) * 100}%`;
    $('hint').textContent = 'Tap the card or press Space to reveal';
    flash.classList.remove('revealed');
    flash.setAttribute('role', 'button');
    flash.tabIndex = 0;
    flash.setAttribute('aria-label', 'Show answer');
    flash.style.transition = 'none';
    flash.style.transform = '';
    flash.style.opacity = '';

    if (mode === 'recall') {
      front.append(el('div', 'prompt', c.m.slice(0, 3).join(', ')), el('div', 'ask', 'What is the kanji? Picture it, then reveal.'));
    } else {
      front.append(el('div', 'big', c.k, 'ja'), el('div', 'ask', mode === 'meaning' ? 'What does it mean?' : 'How is it read?'));
    }

    const pic = el('div', 'pic');
    const art = document.createElement('img');
    art.src = c.a;
    art.alt = `Drawing for ${c.k}`;
    pic.append(art, el('div', 'big', c.k, 'ja'));
    back.append(pic, el('div', 'answer', c.m.join(', ')));
    if (c.on.length) {
      const r = el('div', 'rd');
      r.append(el('small', '', 'on '), el('span', '', c.on.join('、'), 'ja'));
      back.append(r);
    }
    if (c.kun.length) {
      const r = el('div', 'rd');
      r.append(el('small', '', 'kun '), el('span', '', c.kun.slice(0, 4).join('、'), 'ja'));
      back.append(r);
    }
    back.append(el('p', 'note', c.n));
    const link = el('a', '', 'Open full card') as HTMLAnchorElement;
    link.href = c.u;
    link.target = '_blank';
    back.append(link);
  }

  function reveal() {
    if (revealed || !queue.length) return;
    revealed = true;
    const c = queue[0];
    $('front').hidden = true;
    $('back').hidden = false;
    flash.classList.add('revealed');
    flash.removeAttribute('role');
    flash.removeAttribute('tabindex');
    flash.removeAttribute('aria-label');
    $('hint').textContent = 'Swipe left for Again, right for Good, or press 1 to 4';
    const now = new Date();
    const times = preview(store, c, mode, now);
    const row = GRADES.map(({ rating, label, key }) => {
      const b = el('button', 'btn') as HTMLButtonElement;
      b.type = 'button';
      b.append(label, el('small', '', formatInterval(times[rating], now)));
      b.title = `Shortcut: ${key}`;
      b.addEventListener('click', () => rate(rating));
      return b;
    });
    $('grades').replaceChildren(...row);
    $('grades').hidden = false;
  }

  function rate(rating: Grade) {
    if (!revealed) return;
    const now = new Date();
    const c = queue.shift()!;
    const due = grade(store, c, mode, rating, now);
    saveStore(store);
    reviewed++;
    // Cards due again within the sitting come back at the end of the queue.
    if (+due - +now < 20 * 60000) queue.push(c);
    if (queue.length) renderCard();
    else finish();
  }

  function finish() {
    $('done-msg').textContent = reviewed
      ? `You reviewed ${reviewed} ${reviewed === 1 ? 'card' : 'cards'}. Come back tomorrow for the next batch.`
      : 'Nothing was reviewed this time.';
    show('done');
    if (reviewed) celebrate();
  }

  function celebrate() {
    const box = $('confetti');
    const colors = ['--t0', '--t1', '--t2', '--t3', '--t4'];
    box.replaceChildren(...Array.from({ length: 36 }, (_, i) => {
      const bit = document.createElement('i');
      bit.style.left = `${Math.random() * 100}%`;
      bit.style.background = `var(${colors[i % colors.length]})`;
      bit.style.animationDelay = `${Math.random() * 0.6}s`;
      return bit;
    }));
    setTimeout(() => box.replaceChildren(), 2600);
  }

  function begin() {
    mode = store.settings.mode;
    queue = buildQueue(store, inLevel(), mode, store.settings.newPerDay, new Date());
    reviewed = 0;
    sessionSize = queue.length;
    if (!queue.length) return;
    show('session');
    renderCard();
  }

  flash.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) return;
    reveal();
  });
  attachSwipe(flash, {
    canSwipe: () => revealed,
    onSwipe: (dir) => rate(dir === 'left' ? Rating.Again : Rating.Good),
    onMove: (dx) => {
      $('tag-again').style.opacity = String(Math.min(Math.max(-dx, 0) / 90, 1));
      $('tag-good').style.opacity = String(Math.min(Math.max(dx, 0) / 90, 1));
    },
  });
  addEventListener('keydown', (e) => {
    if ($('session').hidden || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === ' ' || e.key === 'Enter') {
      if ((e.target as Element).closest?.('button, a, summary')) return;
      e.preventDefault();
      reveal();
    }
    const g = GRADES.find((x) => x.key === e.key);
    if (g) rate(g.rating);
  });

  form.addEventListener('change', readForm);
  start.addEventListener('click', begin);
  $('quit').addEventListener('click', finish);
  $('again').addEventListener('click', () => { show('setup'); refresh(); });

  $('export').addEventListener('click', () => {
    const url = URL.createObjectURL(new Blob([JSON.stringify(store)], { type: 'application/json' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'sonnakanji-backup.json';
    a.click();
    URL.revokeObjectURL(url);
  });
  $<HTMLInputElement>('import').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      store = parseStore(await file.text());
      saveStore(store);
      writeForm();
      refresh();
      $('backup-msg').textContent = 'Backup restored.';
    } catch {
      $('backup-msg').textContent = "That file isn't a SonnaKanji backup.";
    }
    input.value = '';
  });
  // Erasing is permanent, so the button asks once more in place.
  const reset = $<HTMLButtonElement>('reset');
  let disarm = 0;
  const armReset = (armed: boolean) => {
    reset.classList.toggle('armed', armed);
    reset.textContent = armed ? 'Tap again to erase everything' : 'Reset all progress';
    clearTimeout(disarm);
    if (armed) disarm = window.setTimeout(() => armReset(false), 4000);
  };
  reset.addEventListener('click', () => {
    if (!reset.classList.contains('armed')) return armReset(true);
    armReset(false);
    store = { ...emptyStore(), settings: store.settings };
    saveStore(store);
    refresh();
    $('backup-msg').textContent = 'Progress erased.';
  });

  const levelParam = new URLSearchParams(location.search).get('level');
  if (levelParam === 'N5' || levelParam === 'N4') store.settings.level = levelParam;
  writeForm();

  fetch('/cards.json')
    .then((r) => {
      if (!r.ok) throw new Error(String(r.status));
      return r.json();
    })
    .then((data: C[]) => {
      cards = data;
      byKanji = new Map(data.map((c) => [c.k, c]));
      refresh();
    })
    .catch(() => {
      start.textContent = "Couldn't load cards. Refresh to try again.";
    });
</script>
