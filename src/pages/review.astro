---
import Base from '../layouts/Base.astro';
---
<Base
  title="Free kanji SRS review for JLPT N5 and N4 | SonnaKanji"
  description="Review JLPT N5 and N4 kanji with spaced repetition, like Anki. Free, no sign-up, and your progress stays in your browser."
>
  <div class="review">
    <section id="setup">
      <h1>Review</h1>
      <p class="muted">Spaced repetition shows each kanji just before you'd forget it. No account needed: progress stays in this browser.</p>
      <noscript><p>Reviewing needs JavaScript. The kanji cards work without it.</p></noscript>
      <div class="stats" aria-live="polite">
        <div><b id="s-due">–</b><span>Due</span></div>
        <div><b id="s-new">–</b><span>New today</span></div>
        <div><b id="s-learned">–</b><span>Learned</span></div>
      </div>
      <form id="settings" class="settings">
        <label>Level
          <select name="level"><option value="all">N5 + N4</option><option value="N5">N5</option><option value="N4">N4</option></select>
        </label>
        <label>Test me on
          <select name="mode">
            <option value="meaning">Kanji → meaning</option>
            <option value="reading">Kanji → reading</option>
            <option value="recall">Meaning → kanji</option>
          </select>
        </label>
        <label>New cards per day
          <select name="newPerDay"><option>5</option><option>10</option><option>20</option><option>50</option></select>
        </label>
      </form>
      <button class="btn primary start" id="start" disabled>Loading…</button>
      <details class="backup">
        <summary>Back up or move progress</summary>
        <p class="muted">Progress lives only in this browser. Clearing site data erases it, so keep a backup.</p>
        <button class="btn" id="export">Download backup</button>
        <label class="btn">Restore backup<input id="import" type="file" accept="application/json" hidden /></label>
        <button class="btn" id="reset">Reset all progress</button>
        <p id="backup-msg" class="muted" role="status"></p>
      </details>
    </section>

    <section id="session" hidden>
      <div class="progress"><span id="remaining"></span><button class="link" id="quit">End session</button></div>
      <div class="flash" id="flash" tabindex="0" role="button" aria-label="Show answer">
        <span class="swipe-tag again" id="tag-again">Again</span>
        <span class="swipe-tag good" id="tag-good">Good</span>
        <div id="front"></div>
        <div id="back" hidden></div>
      </div>
      <p class="hint muted" id="hint"></p>
      <div class="grades" id="grades" hidden></div>
    </section>

    <section id="done" hidden>
      <h2>Nice work.</h2>
      <p id="done-msg"></p>
      <button class="btn primary" id="again">Back to review</button>
    </section>
  </div>
</Base>

<style is:global>
  .review { max-width: 520px; margin: 0 auto; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 16px 0; }
  .stats div { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 10px; text-align: center; }
  .stats b { display: block; font: 700 26px var(--serif); }
  .stats span { font-size: 13px; color: var(--muted); }
  .settings { display: grid; gap: 10px; margin-bottom: 16px; }
  .settings label { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-weight: 600; font-size: 15px; }
  .settings select { font: 16px var(--sans); padding: 8px; border-radius: 10px; border: 1px solid var(--line); background: var(--card); color: var(--ink); }
  .start { width: 100%; padding: 14px; font-size: 17px; }
  .start:disabled { opacity: .55; cursor: default; }
  .backup { margin-top: 20px; font-size: 15px; }
  .backup .btn { font-size: 14px; padding: 8px 12px; margin: 0 6px 6px 0; }
  .progress { display: flex; justify-content: space-between; color: var(--muted); font-size: 14px; margin-bottom: 8px; }
  .link { background: none; border: 0; color: inherit; text-decoration: underline; font: inherit; cursor: pointer; padding: 0; }
  .flash {
    position: relative; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 22px 18px; min-height: 340px; display: flex; flex-direction: column; justify-content: center;
    text-align: center; touch-action: pan-y; cursor: pointer; user-select: none; -webkit-user-select: none; overflow-wrap: anywhere;
  }
  .flash .big { font: 500 110px/1.2 var(--serif); }
  .flash .prompt { font: 600 24px/1.3 var(--sans); }
  .flash .ask { color: var(--muted); font-size: 14px; margin-top: 8px; }
  .flash .answer { font: 600 21px/1.3 var(--sans); margin: 4px 0; }
  .flash .rd { font-size: 17px; margin: 2px 0; }
  .flash .rd small { color: var(--muted); }
  .flash .note { font: 500 16px/1.45 var(--serif); margin: 12px 0 0; text-align: left; }
  .flash img { width: 64px; height: 64px; margin: 8px auto 0; display: block; filter: var(--glyph-filter); }
  .flash a { font-size: 13px; color: var(--muted); }
  .swipe-tag { position: absolute; top: 14px; font: 700 13px var(--sans); padding: 3px 9px; border-radius: 7px; opacity: 0; color: #fff; }
  .swipe-tag.again { right: 14px; background: var(--p0); }
  .swipe-tag.good { left: 14px; background: var(--p2); }
  .hint { text-align: center; font-size: 13px; min-height: 20px; margin: 10px 0; }
  .grades { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .grades button { padding: 10px 2px; display: grid; gap: 1px; justify-items: center; touch-action: manipulation; }
  .grades small { font-weight: 400; color: var(--muted); font-size: 12px; }
</style>

<script>
  import {
    buildQueue, formatInterval, GRADES, grade, loadStore, parseStore, preview, saveStore, summarize, emptyStore,
    introducedToday, type Mode, type Store,
  } from '../lib/srs';
  import { attachSwipe } from '../lib/swipe';
  import { Rating, type Grade } from 'ts-fsrs';

  interface C { k: string; l: string; m: string[]; on: string[]; kun: string[]; n: string; g: string | null; ge: string | null }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('settings');
  const flash = $('flash');
  const start = $<HTMLButtonElement>('start');

  let store: Store = loadStore();
  let cards: C[] = [];
  let byKanji = new Map<string, C>();
  let queue: string[] = [];
  let reviewed = 0;
  let mode: Mode = 'meaning';
  let revealed = false;

  const show = (name: 'setup' | 'session' | 'done') => {
    for (const s of ['setup', 'session', 'done']) $(s).hidden = s !== name;
  };
  const inLevel = () => cards.filter((c) => store.settings.level === 'all' || c.l === store.settings.level).map((c) => c.k);

  function refresh() {
    const now = new Date();
    const list = inLevel();
    const s = store.settings;
    const { due, fresh, learned } = summarize(store, list, s.mode, now);
    const room = Math.max(s.newPerDay - introducedToday(store, s.mode, now), 0);
    const newToday = Math.min(fresh, room);
    $('s-due').textContent = String(due);
    $('s-new').textContent = String(newToday);
    $('s-learned').textContent = String(learned);
    start.disabled = due + newToday === 0;
    start.textContent = due + newToday ? `Start ${due + newToday} cards` : 'All caught up for today';
  }

  function readForm() {
    const d = new FormData(form);
    store.settings = {
      level: d.get('level') as Store['settings']['level'],
      mode: d.get('mode') as Mode,
      newPerDay: Number(d.get('newPerDay')),
    };
    saveStore(store);
    refresh();
  }

  function writeForm() {
    const s = store.settings;
    (form.elements.namedItem('level') as HTMLSelectElement).value = s.level;
    (form.elements.namedItem('mode') as HTMLSelectElement).value = s.mode;
    (form.elements.namedItem('newPerDay') as HTMLSelectElement).value = String(s.newPerDay);
  }

  function el(tag: string, cls: string, text?: string, lang?: string) {
    const n = document.createElement(tag);
    n.className = cls;
    if (text !== undefined) n.textContent = text;
    if (lang) n.lang = lang;
    return n;
  }

  function renderCard() {
    const c = byKanji.get(queue[0])!;
    revealed = false;
    const front = $('front');
    const back = $('back');
    front.replaceChildren();
    back.replaceChildren();
    back.hidden = true;
    front.hidden = false;
    $('grades').hidden = true;
    $('remaining').textContent = `${queue.length} left`;
    $('hint').textContent = 'Tap the card or press Space to reveal';
    flash.setAttribute('aria-label', 'Show answer');
    flash.style.transition = 'none';
    flash.style.transform = '';
    flash.style.opacity = '';

    if (mode === 'recall') {
      front.append(el('div', 'prompt', c.m.slice(0, 3).join(', ')), el('div', 'ask', 'What is the kanji? Picture it, then reveal.'));
    } else {
      front.append(el('div', 'big', c.k, 'ja'), el('div', 'ask', mode === 'meaning' ? 'What does it mean?' : 'How is it read?'));
    }

    back.append(el('div', 'big', c.k, 'ja'), el('div', 'answer', c.m.join(', ')));
    if (c.on.length) {
      const r = el('div', 'rd');
      r.append(el('small', '', 'on '), el('span', '', c.on.join('、'), 'ja'));
      back.append(r);
    }
    if (c.kun.length) {
      const r = el('div', 'rd');
      r.append(el('small', '', 'kun '), el('span', '', c.kun.slice(0, 4).join('、'), 'ja'));
      back.append(r);
    }
    back.append(el('p', 'note', c.n));
    if (c.g) {
      const img = document.createElement('img');
      img.src = c.g;
      img.alt = `${c.ge} script form of ${c.k}`;
      back.append(img);
    }
    const link = el('a', '', 'Open full card') as HTMLAnchorElement;
    link.href = `/kanji/${c.k}/`;
    link.target = '_blank';
    back.append(link);
  }

  function reveal() {
    if (revealed || !queue.length) return;
    revealed = true;
    const c = queue[0];
    $('front').hidden = true;
    $('back').hidden = false;
    flash.removeAttribute('aria-label');
    $('hint').textContent = 'Swipe left for Again, right for Good, or press 1 to 4';
    const now = new Date();
    const times = preview(store, c, mode, now);
    const row = GRADES.map(({ rating, label, key }) => {
      const b = el('button', 'btn') as HTMLButtonElement;
      b.type = 'button';
      b.append(label, el('small', '', formatInterval(times[rating], now)));
      b.title = `Shortcut: ${key}`;
      b.addEventListener('click', () => rate(rating));
      return b;
    });
    $('grades').replaceChildren(...row);
    $('grades').hidden = false;
  }

  function rate(rating: Grade) {
    if (!revealed) return;
    const now = new Date();
    const c = queue.shift()!;
    const due = grade(store, c, mode, rating, now);
    saveStore(store);
    reviewed++;
    // Cards due again within the sitting come back at the end of the queue.
    if (+due - +now < 20 * 60000) queue.push(c);
    if (queue.length) renderCard();
    else finish();
  }

  function finish() {
    $('done-msg').textContent = reviewed
      ? `You reviewed ${reviewed} ${reviewed === 1 ? 'card' : 'cards'}. Come back tomorrow for the next batch.`
      : 'Nothing was reviewed this time.';
    show('done');
  }

  function begin() {
    mode = store.settings.mode;
    queue = buildQueue(store, inLevel(), mode, store.settings.newPerDay, new Date());
    reviewed = 0;
    if (!queue.length) return;
    show('session');
    renderCard();
  }

  flash.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) return;
    reveal();
  });
  attachSwipe(flash, {
    canSwipe: () => revealed,
    onSwipe: (dir) => rate(dir === 'left' ? Rating.Again : Rating.Good),
    onMove: (dx) => {
      $('tag-again').style.opacity = String(Math.min(Math.max(-dx, 0) / 90, 1));
      $('tag-good').style.opacity = String(Math.min(Math.max(dx, 0) / 90, 1));
    },
  });
  addEventListener('keydown', (e) => {
    if ($('session').hidden || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === ' ' || e.key === 'Enter') {
      if ((e.target as Element).closest?.('button, a, summary')) return;
      e.preventDefault();
      reveal();
    }
    const g = GRADES.find((x) => x.key === e.key);
    if (g) rate(g.rating);
  });

  form.addEventListener('change', readForm);
  start.addEventListener('click', begin);
  $('quit').addEventListener('click', finish);
  $('again').addEventListener('click', () => { show('setup'); refresh(); });

  $('export').addEventListener('click', () => {
    const url = URL.createObjectURL(new Blob([JSON.stringify(store)], { type: 'application/json' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'sonnakanji-backup.json';
    a.click();
    URL.revokeObjectURL(url);
  });
  $<HTMLInputElement>('import').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      store = parseStore(await file.text());
      saveStore(store);
      writeForm();
      refresh();
      $('backup-msg').textContent = 'Backup restored.';
    } catch {
      $('backup-msg').textContent = "That file isn't a SonnaKanji backup.";
    }
    input.value = '';
  });
  $('reset').addEventListener('click', () => {
    if (!confirm('Erase all review progress in this browser?')) return;
    const settings = store.settings;
    store = { ...emptyStore(), settings };
    saveStore(store);
    refresh();
  });

  const levelParam = new URLSearchParams(location.search).get('level');
  if (levelParam === 'N5' || levelParam === 'N4') store.settings.level = levelParam;
  writeForm();

  fetch('/cards.json')
    .then((r) => {
      if (!r.ok) throw new Error(String(r.status));
      return r.json();
    })
    .then((data: C[]) => {
      cards = data;
      byKanji = new Map(data.map((c) => [c.k, c]));
      refresh();
    })
    .catch(() => {
      start.textContent = "Couldn't load cards. Refresh to try again.";
    });
</script>
