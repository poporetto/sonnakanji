---
import Base from '../../layouts/Base.astro';
import KanjiCard from '../../components/KanjiCard.astro';
import { allKanji, isBeta, kanjiPath, byLevel, slugOf, type Kanji } from '../../lib/kanji';

export function getStaticPaths() {
  return allKanji.map((k, i) => ({
    params: { kanji: slugOf(k.kanji) },
    props: {
      k,
      prev: allKanji[(i - 1 + allKanji.length) % allKanji.length],
      next: allKanji[(i + 1) % allKanji.length],
    },
  }));
}

interface Props { k: Kanji; prev: Kanji; next: Kanji }
const { k, prev, next } = Astro.props;
const sameLevel = byLevel(k.level);
const position = sameLevel.findIndex((x) => x.kanji === k.kanji) + 1;
const reading = [...k.kun.slice(0, 1), ...k.on.slice(0, 1)].map((r) => r.romaji).filter(Boolean).join(', ');
const beta = isBeta(k);
const headline = k.meanings[0].replace(/^./, (c) => c.toUpperCase());
const reading1 = reading.split(', ')[0];
const title = beta
  ? `${k.kanji} (${reading1}) Kanji Meaning: "${headline}" | JLPT ${k.level} Kanji`
  : `${k.kanji} (${reading1}) Kanji Meaning: "${headline}" | Learn Kanji with Pictures`;
const description = beta
  ? `${k.kanji} means ${k.meanings.slice(0, 3).join(', ')}. Readings, stroke order, parts and common words for this JLPT ${k.level} kanji.`
  : `${k.kanji} means ${k.meanings.slice(0, 3).join(', ')}. ${k.mnemonic} Learn this JLPT ${k.level} kanji with a picture, readings and stroke order.`;
const url = new URL(kanjiPath(k.kanji), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTerm',
      name: k.kanji,
      url,
      inLanguage: 'ja',
      description: k.meanings.join(', '),
      termCode: `U+${k.kanji.codePointAt(0)!.toString(16).toUpperCase()}`,
      inDefinedTermSet: { '@type': 'DefinedTermSet', name: `JLPT ${k.level} kanji`, url: new URL(`/jlpt/${k.level.toLowerCase()}/`, Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: `JLPT ${k.level} kanji`, item: new URL(`/jlpt/${k.level.toLowerCase()}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: k.kanji, item: url },
      ],
    },
  ],
};
---
<Base {title} {description} {jsonLd} prefetch={[kanjiPath(next.kanji), kanjiPath(prev.kanji)]}>
  <KanjiCard {k} {position} total={sameLevel.length} {prev} {next} />
</Base>
