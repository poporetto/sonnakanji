---
import { commonReading } from '../../lib/reading';
import Base from '../../layouts/Base.astro';
import KanjiCard from '../../components/KanjiCard.astro';
import { allKanji, kanjiPath, byLevel, slugOf, type Kanji } from '../../lib/kanji';

export function getStaticPaths() {
  return allKanji.map((k, i) => ({
    params: { kanji: slugOf(k.kanji) },
    props: {
      k,
      prev: allKanji[(i - 1 + allKanji.length) % allKanji.length],
      next: allKanji[(i + 1) % allKanji.length],
    },
  }));
}

interface Props { k: Kanji; prev: Kanji; next: Kanji }
const { k, prev, next } = Astro.props;
const sameLevel = byLevel(k.level);
const position = sameLevel.findIndex((x) => x.kanji === k.kanji) + 1;
const reading = [...k.kun.slice(0, 1), ...k.on.slice(0, 1)].map((r) => r.romaji).filter(Boolean).join(', ');
const headline = k.meanings[0].replace(/^./, (c) => c.toUpperCase());
const reading1 = commonReading(k);
// Search results cut off long titles and descriptions, so each one keeps as much as fits.
const fit = (limit: number, ...options: string[]) => options.find((o) => o.length <= limit) ?? options[options.length - 1].slice(0, limit);
const named = `${k.kanji} (${reading1}) Kanji Meaning: "${headline}"`;
const title = fit(70, `${named} | Learn Kanji with Pictures`, `${named} | SonnaKanji`, named, `${k.kanji} (${reading1}) Kanji: ${headline}`);
const means = (n: number) => `${k.kanji} means ${k.meanings.slice(0, n).join(', ')}.`;
const lesson = `Learn this JLPT ${k.level} kanji with a picture, readings and stroke order.`;
const full = `${means(3)} ${k.mnemonic} ${lesson}`;
const description = full.length < 120
  ? `${full} Review it free with spaced repetition.`
  : fit(160, full, `${means(2)} ${k.mnemonic} ${lesson}`, `${means(1)} ${k.mnemonic} ${lesson}`, `${means(1)} ${k.mnemonic} A JLPT ${k.level} kanji.`, `${means(1)} ${lesson}`);
const url = new URL(kanjiPath(k.kanji), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTerm',
      name: k.kanji,
      url,
      description: k.meanings.join(', '),
      termCode: `U+${k.kanji.codePointAt(0)!.toString(16).toUpperCase()}`,
      inDefinedTermSet: { '@type': 'DefinedTermSet', name: `JLPT ${k.level} kanji`, inLanguage: 'ja', url: new URL(`/jlpt/${k.level.toLowerCase()}/`, Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: `JLPT ${k.level} kanji`, item: new URL(`/jlpt/${k.level.toLowerCase()}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: k.kanji, item: url },
      ],
    },
  ],
};
---
<Base {title} {description} {jsonLd} prefetch={[kanjiPath(next.kanji), kanjiPath(prev.kanji)]}>
  <KanjiCard {k} {position} total={sameLevel.length} {prev} {next} />
</Base>
