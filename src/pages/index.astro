---
import Base from '../layouts/Base.astro';
import KanjimonBanner from '../components/KanjimonBanner.astro';
import KanjiTile from '../components/KanjiTile.astro';
import { allKanji, artPath, byLevel, kanjiPath, LEVELS } from '../lib/kanji';

const pick = (chars: string) => [...chars].map((c) => allKanji.find((k) => k.kanji === c)!);
const collage = pick('休木山明');
const samples = pick('日月火川口女家人');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SonnaKanji',
  url: Astro.site?.href,
  description: 'Illustrated JLPT kanji mnemonics with free spaced repetition review, from N5 to N1.',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: new URL('/search/?q={query}', Astro.site).href },
    'query-input': 'required name=query',
  },
};
---
<Base
  title="SonnaKanji: learn JLPT kanji with pictures, N5 to N1"
  description="Learn all 2,211 JLPT kanji with pictures, from N5 to N1. Each has a drawing, a mnemonic, readings and stroke order, plus free spaced repetition review. N3 to N1 are in beta."
  {jsonLd}
>
  <section class="intro">
    <div class="pitch">
      <img src="/mascot/bear.webp" alt="" width="150" height="118" />
      <h1>Kanji you can picture</h1>
      <p>Each drawing follows the real shape of the kanji, so the picture and the character stick together.</p>
      <p class="cta">
        <a class="btn primary" href="/jlpt/n5/">Start with N5</a>
        <a class="btn" href="/review/">Review my cards</a>
      </p>
      <p class="how"><a href="/learn-kanji-with-pictures/">How learning kanji with pictures works</a></p>
    </div>
    <ul class="bento">
      {collage.map((k, i) => (
        <li><a class="flip" href={kanjiPath(k.kanji)} style={`background:var(--t${i % 5});--n:${i}`}>
          <img src={artPath(k.kanji)} alt={`Drawing for ${k.kanji}, ${k.meanings[0]}`} width="200" height="200" />
          <span lang="ja" aria-hidden="true">{k.kanji}</span>
        </a></li>
      ))}
    </ul>
  </section>

  <h2>Pick your level</h2>
  <div class="levels">
    {LEVELS.map((l, i) => (
      <a class="level" style={`background:var(--t${i % 5})`} href={`/jlpt/${l.slug}/`}>
        <span class="count">{byLevel(l.id).length}</span>
        <span class="info"><b>JLPT {l.id} kanji{l.beta && <span class="beta">Beta</span>}</b><span>{l.blurb}</span></span>
      </a>
    ))}
  </div>

  <h2>Try a few</h2>
  <ul class="grid few">
    {samples.map((k, i) => <li><KanjiTile {k} index={i} /></li>)}
  </ul>

  <KanjimonBanner />
</Base>

<style>
  .intro { display: grid; gap: 16px; align-items: center; padding-block: 8px; }
  .how a { display: inline-block; padding-block: 11px; }
  .pitch img { display: block; width: 92px; height: auto; margin-bottom: 10px; }
  h1 { font-size: clamp(46px, 13vw, 76px); font-weight: 600; line-height: 1; letter-spacing: -.035em; margin: 0 0 14px; }
  .pitch p { font-size: 18px; max-width: 32em; margin: 0; color: var(--muted); }
  .how { margin-top: 2px !important; font-size: 15px !important; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px !important; }
  .bento { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .bento li { min-width: 0; }
  .flip { position: relative; display: grid; border-radius: 22px; padding: 4px; color: var(--on-tint); text-decoration: none; transition: transform .16s cubic-bezier(.2, .8, .2, 1); }
  .flip:active { transform: var(--press); }
  .flip > * { grid-area: 1 / 1; }
  .flip img { display: block; width: 100%; height: auto; animation: show-pic 12s ease-in-out infinite; animation-delay: calc(var(--n) * 3s); }
  .flip span { display: grid; place-items: center; font: 500 clamp(44px, 13vw, 92px)/1 var(--jp); opacity: 0; animation: show-kanji 12s ease-in-out infinite; animation-delay: calc(var(--n) * 3s); }
  @keyframes show-pic { 0%, 62%, 100% { opacity: 1; transform: none; } 70%, 92% { opacity: 0; transform: scale(.92); } }
  @keyframes show-kanji { 0%, 62%, 100% { opacity: 0; transform: scale(1.08); } 70%, 92% { opacity: 1; transform: none; } }
  @media (hover: hover) { .bento:hover .flip * { animation-play-state: paused; } .flip:hover { transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) { .flip img, .flip span { animation: none; } }
  .few { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  h2 { margin: 38px 0 14px; font-size: 26px; }
  .levels { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .level { display: flex; gap: 14px; align-items: center; color: var(--on-tint); border-radius: var(--radius); padding: 18px 20px; text-decoration: none; transition: transform .16s cubic-bezier(.2, .8, .2, 1); }
  .level:active { transform: var(--press); }
  @media (hover: hover) { .level:hover { transform: translateY(-3px); } }
  .count { font: 600 44px/1 var(--display); letter-spacing: -.03em; min-width: 2.3ch; }
  .info { display: grid; min-width: 0; font-size: 14px; font-weight: 500; line-height: 1.35; }
  .info b { display: flex; align-items: center; gap: 8px; font: 600 18px var(--display); }
  @media (min-width: 760px) {
    .intro { grid-template-columns: 1.1fr 1fr; gap: 28px; }
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .few { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  }
</style>
