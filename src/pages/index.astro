---
import Base from '../layouts/Base.astro';
import { allKanji, byLevel, kanjiPath, LEVELS } from '../lib/kanji';

const samples = ['火', '休', '山', '明', '花', '男'].map((c) => allKanji.find((k) => k.kanji === c)).filter((k) => k !== undefined);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SonnaKanji',
  url: Astro.site?.href,
  description: 'Kanji mnemonics for JLPT N5 and N4, built from the real history of each character.',
};
---
<Base
  title="SonnaKanji: JLPT N5 and N4 kanji mnemonics with pictures"
  description="Remember kanji through the drawings they grew from. 245 JLPT N5 and N4 kanji with mnemonics, readings, stroke order and free spaced repetition review."
  {jsonLd}
>
  <section class="hero">
    <h1>Kanji began as pictures.</h1>
    <p>See the ancient forms behind each character, remember it with one short sentence, then lock it in with spaced repetition.</p>
    <p class="cta">
      <a class="btn primary" href="/jlpt/n5/">Start with N5</a>
      <a class="btn" href="/review/">Review my cards</a>
    </p>
  </section>

  <h2>Pick a level</h2>
  <div class="levels">
    {LEVELS.map((l) => (
      <a class="level" href={`/jlpt/${l.slug}/`}>
        <span class="badge">JLPT {l.id}</span>
        <b>{byLevel(l.id).length} kanji</b>
        <span class="muted">{l.blurb}</span>
      </a>
    ))}
  </div>

  <h2>A few to start with</h2>
  <ul class="grid">
    {samples.map((k) => (
      <li><a href={kanjiPath(k.kanji)}><b lang="ja">{k.kanji}</b><span>{k.meanings[0]}</span></a></li>
    ))}
  </ul>
</Base>

<style>
  .hero { padding: 24px 0 12px; }
  .hero h1 { font: 700 clamp(34px, 8vw, 52px)/1.15 var(--serif); margin: 0 0 12px; }
  .hero p { font-size: 18px; max-width: 560px; margin: 0 0 12px; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px !important; }
  h2 { margin: 36px 0 12px; font-size: 20px; }
  .levels { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .level { display: grid; gap: 4px; justify-items: start; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; text-decoration: none; }
  .level:hover { border-color: var(--seal); }
  .level b { font: 700 24px var(--serif); }
</style>
