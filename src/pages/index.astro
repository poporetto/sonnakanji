---
import Base from '../layouts/Base.astro';
import KanjiTile from '../components/KanjiTile.astro';
import { allKanji, artPath, byLevel, LEVELS } from '../lib/kanji';

const pick = (chars: string) => [...chars].map((c) => allKanji.find((k) => k.kanji === c)!);
const collage = pick('休火魚山');
const samples = pick('犬花雨電走家海');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SonnaKanji',
  url: Astro.site?.href,
  description: 'Illustrated kanji mnemonics for JLPT N5 and N4 with free spaced repetition review.',
};
---
<Base
  title="SonnaKanji: learn JLPT N5 and N4 kanji with pictures"
  description="245 JLPT N5 and N4 kanji, each with a drawing, a one-line mnemonic, readings and stroke order. Swipe through the cards, then review for free with spaced repetition."
  {jsonLd}
>
  <section class="hero-home">
    <div>
      <h1>Kanji you can <em>see.</em></h1>
      <p>Every card pairs a kanji with a silly little drawing and one short sentence. Swipe through them, then lock them in with spaced repetition.</p>
      <p class="cta">
        <a class="btn primary" href="/jlpt/n5/">Start with N5</a>
        <a class="btn" href="/review/">Review my cards</a>
      </p>
    </div>
    <div class="collage" aria-hidden="true">
      {collage.map((k) => (
        <div class="sticker"><img src={artPath(k.kanji)} alt="" width="200" height="200" /><b lang="ja">{k.kanji}</b></div>
      ))}
    </div>
  </section>

  <h2>Pick your level</h2>
  <div class="levels">
    {LEVELS.map((l) => (
      <a class={`level ${l.slug}`} href={`/jlpt/${l.slug}/`}>
        <span class="count">{byLevel(l.id).length}</span>
        <span class="info"><b>JLPT {l.id} kanji</b><span>{l.blurb}</span></span>
      </a>
    ))}
  </div>

  <h2>Try a few</h2>
  <ul class="grid">
    {samples.map((k) => <li><KanjiTile {k} /></li>)}
  </ul>
</Base>

<style>
  .hero-home { display: grid; gap: 20px; padding-block: 12px; align-items: center; }
  h1 { font-size: clamp(54px, 15vw, 92px); font-weight: 800; line-height: .95; letter-spacing: -.04em; margin: 0 0 14px; }
  h1 em { font-style: normal; color: var(--ink); background: linear-gradient(transparent 62%, var(--sun) 62%); }
  .hero-home p { font-size: 18px; max-width: 34em; margin: 0; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px !important; }
  .collage { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .sticker { position: relative; border: 3px solid var(--outline); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-sm); transition: transform .15s; }
  .sticker:nth-child(odd) { transform: rotate(-3deg); }
  .sticker:nth-child(even) { transform: rotate(3deg) translateY(6px); }
  .sticker:hover { transform: rotate(0) scale(1.05); }
  .sticker img { display: block; width: 100%; height: auto; }
  .sticker b { position: absolute; right: 4px; bottom: 2px; color: var(--on-color); font: 700 clamp(18px, 4vw, 26px)/1.1 var(--jp); text-shadow: 0 0 4px #fff, 0 0 4px #fff, 0 0 4px #fff; }
  h2 { margin: 36px 0 14px; font-size: 28px; font-weight: 800; }
  .levels { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .level { display: flex; gap: 14px; align-items: center; color: var(--on-color); border: 3px solid var(--outline); border-radius: var(--radius); box-shadow: var(--shadow); padding: 14px 18px; text-decoration: none; transition: transform .12s; }
  .level:hover { transform: translate(-2px, -2px) rotate(-1deg); }
  .level.n5 { background: var(--sun); }
  .level.n4 { background: var(--mint); }
  .count { font: 800 52px/1 var(--display); letter-spacing: -.03em; }
  .info { display: grid; min-width: 0; font-size: 15px; font-weight: 600; line-height: 1.3; }
  .info b { font: 800 19px var(--display); }
  @media (min-width: 760px) {
    .hero-home { grid-template-columns: 1.15fr 1fr; }
    .collage { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
</style>
