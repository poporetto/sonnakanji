---
import Base from '../layouts/Base.astro';
import KanjiTile from '../components/KanjiTile.astro';
import { allKanji, artPath, byLevel, LEVELS } from '../lib/kanji';

const pick = (chars: string) => [...chars].map((c) => allKanji.find((k) => k.kanji === c)!);
const collage = pick('休木山明');
const samples = pick('日月火川口女家人');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SonnaKanji',
  url: Astro.site?.href,
  description: 'Illustrated kanji mnemonics for JLPT N5 and N4 with free spaced repetition review.',
};
---
<Base
  title="SonnaKanji: learn JLPT N5 and N4 kanji with pictures"
  description="245 JLPT N5 and N4 kanji, each drawn so the picture matches the shape of the character. Swipe through mnemonics, readings and stroke order, then review for free with spaced repetition."
  {jsonLd}
>
  <section class="intro">
    <div class="pitch">
      <img src="/mascot/bear.webp" alt="" width="150" height="118" />
      <h1>Kanji you can picture</h1>
      <p>Each drawing follows the real shape of the kanji, so the picture and the character stick together.</p>
      <p class="cta">
        <a class="btn primary" href="/jlpt/n5/">Start with N5</a>
        <a class="btn" href="/review/">Review my cards</a>
      </p>
      <p class="how"><a href="/learn-kanji-with-pictures/">How learning kanji with pictures works</a></p>
    </div>
    <div class="bento" aria-hidden="true">
      {collage.map((k, i) => (
        <div style={`background:var(--t${i % 5})`}><img src={artPath(k.kanji)} alt="" width="200" height="200" /></div>
      ))}
    </div>
  </section>

  <h2>Pick your level</h2>
  <div class="levels">
    {LEVELS.map((l, i) => (
      <a class="level" style={`background:var(--t${i * 2 + 1})`} href={`/jlpt/${l.slug}/`}>
        <span class="count">{byLevel(l.id).length}</span>
        <span class="info"><b>JLPT {l.id} kanji</b><span>{l.blurb}</span></span>
      </a>
    ))}
  </div>

  <h2>Try a few</h2>
  <ul class="grid few">
    {samples.map((k, i) => <li><KanjiTile {k} index={i} /></li>)}
  </ul>
</Base>

<style>
  .intro { display: grid; gap: 16px; align-items: center; padding-block: 8px; }
  .how a { display: inline-block; padding-block: 11px; }
  .pitch img { display: block; width: 130px; height: auto; margin-bottom: 8px; }
  h1 { font-size: clamp(42px, 11vw, 68px); font-weight: 800; line-height: 1.04; letter-spacing: -.03em; margin: 0 0 12px; }
  .pitch p { font-size: 18px; max-width: 32em; margin: 0; color: var(--muted); }
  .how { margin-top: 2px !important; font-size: 15px !important; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px !important; }
  .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .bento div { border-radius: 22px; padding: 4px; }
  .bento img { display: block; width: 100%; height: auto; }
  .few { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  h2 { margin: 34px 0 12px; font-size: 24px; font-weight: 800; letter-spacing: -.02em; }
  .levels { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .level { display: flex; gap: 14px; align-items: center; color: var(--on-tint); border-radius: var(--radius); padding: 18px 20px; text-decoration: none; transition: transform .16s cubic-bezier(.2, .8, .2, 1); }
  .level:active { transform: var(--press); }
  @media (hover: hover) { .level:hover { transform: translateY(-3px); } }
  .count { font-size: 46px; font-weight: 800; line-height: 1; letter-spacing: -.03em; }
  .info { display: grid; min-width: 0; font-size: 15px; font-weight: 600; line-height: 1.35; }
  .info b { font-size: 18px; font-weight: 800; }
  @media (min-width: 760px) {
    .intro { grid-template-columns: 1.1fr 1fr; gap: 28px; }
    .bento { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .few { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  }
</style>
