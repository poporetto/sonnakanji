---
import { allKanji } from '../lib/kanji';

// Just enough of the three starters to draw them live on the game's own artwork.
const starters = { fire: '火', water: '水', wood: '木' };
const crew = Object.entries(starters).map(([type, k]) => {
  const c = allKanji.find((x) => x.kanji === k)!;
  return { k, m: c.meanings[0], type, strokes: c.strokes, moves: [], level: 'N5', d: c.vg.strokes.map((s) => s.d) };
});
---
<a class="kanjimon" href="/kanjimon/">
  <canvas id="kanjimon-art" width="240" height="120" data-crew={JSON.stringify(crew)} role="img" aria-label="The starter kanji 火, 水 and 木 at sunset, drawn as pixel creatures"></canvas>
  <div class="copy">
    <h2>Play Kanjimon</h2>
    <p>Help bring the world's blank signs back in a free pixel adventure. Catch all 245 N5 and N4 kanji, and battle with real words.</p>
    <span class="btn primary">Start the adventure</span>
  </div>
</a>

<script>
  import type { Species } from '../kanjimon/battle';
  import { kanjiSprite } from '../kanjimon/sprites';
  import { backdrop } from '../kanjimon/world';

  const art = document.getElementById('kanjimon-art') as HTMLCanvasElement;
  const g = art.getContext('2d')!;
  g.imageSmoothingEnabled = false;
  g.drawImage(backdrop('title'), 0, -40);
  g.fillStyle = '#ffe9b0';
  g.beginPath(); g.arc(206, 26, 11, 0, 7); g.fill();
  (JSON.parse(art.dataset.crew!) as Species[]).forEach((s, i) => g.drawImage(kanjiSprite(s, 48), 24 + i * 66, 54));
</script>

<style>
  .kanjimon { display: grid; margin-top: 44px; overflow: hidden; border-radius: var(--radius); background: var(--surface); box-shadow: var(--soft), 0 0 0 1px var(--line); color: var(--ink); text-decoration: none; transition: transform .16s cubic-bezier(.2, .8, .2, 1); }
  .kanjimon:active { transform: var(--press); }
  canvas { display: block; width: 100%; aspect-ratio: 2 / 1; image-rendering: pixelated; background: #5a4a8c; }
  .copy { display: grid; justify-items: start; gap: 10px; padding: 20px; }
  h2 { margin: 0; font-size: 28px; }
  p { margin: 0; max-width: 42ch; color: var(--muted); }
  @media (hover: hover) { .kanjimon:hover { transform: translateY(-3px); } }
  @media (min-width: 760px) {
    .kanjimon { grid-template-columns: 1.1fr 1fr; align-items: center; }
    canvas { height: 100%; }
    .copy { padding: 24px 28px; }
  }
</style>
