---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import GoogleTag from '../components/GoogleTag.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object;
  prefetch?: string[];
}
const { title, description, noindex = false, jsonLd, prefetch = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const here = Astro.url.pathname;
const shareImage = new URL('/og/sonnakanji.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <GoogleTag />
    <Analytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SonnaKanji" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SonnaKanji, learn kanji with pictures" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <script is:inline>
      // Applied before first paint so saved settings never flash. See lib/prefs.ts.
      try {
        const p = JSON.parse(localStorage.getItem('sonnakanji.prefs.v1') || '{}');
        const root = document.documentElement;
        if (p.theme === 'light' || p.theme === 'dark') root.dataset.theme = p.theme;
        if (p.romaji === false) root.dataset.romaji = 'off';
        if (p.motion === false) root.dataset.motion = 'reduced';
      } catch {}
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f8edc9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2a2118" media="(prefers-color-scheme: dark)" />
    {prefetch.map((href) => <link rel="prefetch" href={href} />)}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <header class="site-head">
      <div class="wrap"><div class="site-bar">
        <a class="brand" href="/" aria-label="SonnaKanji home"><img src="/mascot/bear.webp" alt="" width="48" height="38" /><span>SonnaKanji</span></a>
        <nav aria-label="Main">
          <a href="/jlpt/" aria-current={here.startsWith('/jlpt') ? 'page' : undefined}>Levels</a>
          <a href="/review/" aria-current={here.startsWith('/review') ? 'page' : undefined}>Review</a>
          <a class="gear" href="/search/" aria-label="Search" aria-current={here.startsWith('/search') ? 'page' : undefined}>
            <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
          </a>
          <a class="gear" href="/settings/" aria-label="Settings" aria-current={here.startsWith('/settings') ? 'page' : undefined}>
            <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2.4" /><circle cx="8" cy="17" r="2.4" /></svg>
          </a>
        </nav>
      </div></div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site-foot">
      <div class="wrap">
        <p>Built on open data from KANJIDIC, Wiktionary, Wikimedia Commons and KanjiVG.</p>
        <p class="foot-links"><a href="/learn-kanji-with-pictures/">How to learn kanji with pictures</a><a href="/kanjimono/">Play Kanjimono</a><a href="/about/">Sources and licences</a></p>
      </div>
    </footer>
  </body>
</html>
